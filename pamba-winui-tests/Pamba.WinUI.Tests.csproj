<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\test.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>Pamba.WinUI.Tests</RootNamespace>
    <AssemblyName>Pamba.WinUI.Tests</AssemblyName>

    <!--
      The Windows App SDK emits its bootstrap auto-initialiser only for projects producing an
      executable. Without this opt-in a test DLL fails every WinRT activation with
      REGDB_E_CLASSNOTREG.
    -->
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\pamba-winui\Pamba.WinUI.csproj" />
    <ProjectReference Include="..\pamba-testing\Pamba.Testing.csproj" />
  </ItemGroup>

</Project>
